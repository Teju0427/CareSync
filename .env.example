# Copy to .env for local Docker Compose. Never commit the real .env.
POSTGRES_USER=caresync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caresync
JWT_SECRET_KEY=replace-with-a-long-random-value

# Demo data created on first start (set SEED_DEMO_DATA=false to disable)
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@caresync.app
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_DOCTOR_PASSWORD=choose-a-demo-password

# Where the browser reaches the API, and which origins the API allows
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
